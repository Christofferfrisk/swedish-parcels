# IMAP credentials for download_emails.py
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=you@example.com
IMAP_PASSWORD=app-specific-password-here
IMAP_MAILBOX=INBOX

# Comma-separated list of sender addresses or domains to fetch
# e.g. noreply@postnord.com,info@budbee.com,track@instabox.se
PARCEL_SENDERS=

# Airmee live tracker. Capture once from the tracking page:
# 1. Open tracking.airmee.com/sv/#/track/<token> in Chrome
# 2. DevTools → Network → find the track_by_url request
# 3. Copy the phone_number_hash query param value (6 chars, e.g. 2bc85e)
# Same value works forever across all your Airmee parcels.
AIRMEE_PHONE_HASH=
